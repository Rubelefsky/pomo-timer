{
  "name": "pomo-timer",
  "private": true,
  "version": "2.0.0",
  "description": "Pomodoro timer with a dashboard, history, and cross-device sync",
  "author": "Brandon Rubell",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8765",
    "sync": "vite build && cap sync",
    "ios": "vite build && cap sync ios && cap open ios",
    "android": "vite build && cap sync android && cap open android",
    "desktop": "vite build && electron .",
    "desktop:dev": "electron . --dev",
    "desktop:mac": "vite build && electron-builder --mac",
    "desktop:win": "vite build && electron-builder --win",
    "desktop:all": "vite build && electron-builder --mac --win"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0"
  }
}
